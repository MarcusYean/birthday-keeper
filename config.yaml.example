# 生日管家 配置文件
# 把本文件复制为 ./data/config.yaml 后按需修改，重启容器生效。

app:
  port: 8000
  timezone: Asia/Shanghai        # 定时检查所用时区，建议与你的实际时区一致

notify:
  check_hour: 8                  # 每天几点检查（24小时制）
  check_minute: 0
  default_channels:              # 新增联系人时默认使用的渠道（可多选）
    - wechat
    - feishu
  default_notify_days:           # 提前多少天提醒（可多选）
    - 1
    - 3
    - 7

# 邮件渠道（可选，默认关闭）。SMTP 信息可从群晖邮件服务或邮箱提供商获取。
email:
  enabled: false
  smtp_host: ""
  smtp_port: 465
  smtp_user: ""
  smtp_pass: ""
  use_tls: true
  from_addr: ""
  to_addr: ""

# 微信推送：serverchan( Server酱 ) / pushplus / bark
wechat:
  enabled: true
  type: serverchan               # serverchan | pushplus | bark
  token: ""                      # Server酱/PushPlus 的 token，或 Bark 的设备 key
  bark_server: "https://api.day.app"   # 仅 bark 类型需要

# 飞书（Lark）自定义机器人
feishu:
  enabled: true
  webhook: ""                    # 飞书群机器人 webhook 地址
  secret: ""                     # 可选：若机器人开启了「签名校验」则填写

# 界面与外观（也可在网页「设置 → 界面与外观」中调整，保存即生效）
ui:
  menu_position: left           # left（左侧栏）| top（顶部栏）
  contact_edit_mode: modal      # modal（居中弹窗）| drawer（右侧抽屉）
  anniversary_enabled: true     # 是否显示「纪念日」功能入口

# 隐私与注册（也可在网页「设置 → 隐私与注册」中调整，保存即生效）
privacy:
  default_visibility: private   # 新数据的默认可见范围：private（仅自己）| family（家庭）| public（所有人）
  allow_register: false         # 是否开放用户自助注册（开启后登录页出现「注册」入口）

# 消息模板（也可在网页「设置 → 消息模板」中调整，保存即生效）
# 可用变量：{name} {calendar_type} {month} {day} {year} {relationship} {note}
#          {days_until} {age} {age_num} {years_together} {years_together_num} {when}
#          {zodiac} {chinese_zodiac} {next_date} {kind}
templates:
  birthday_title: "🎂 生日提醒：{name}"
  birthday_body: "{when}{name}的生日（{calendar_type}{month}月{day}日）{age}\n关系：{relationship}\n备注：{note}"
  anniversary_title: "📌 {kind}提醒：{name}"
  anniversary_body: "{when}{name}的{kind}（{calendar_type}{month}月{day}日）{years_together}\n关系：{relationship}\n备注：{note}"
  test_title: "🔔 测试通知：{name}"
  test_body: "这是来自「生日管家」的测试消息。\n联系人：{name}\n若你收到这条消息，说明该渠道配置正确 ✅"
  anniversary_test_title: "🔔 测试通知：{name}"
  anniversary_test_body: "这是来自「生日管家」的纪念日测试消息。\n名称：{name}（{kind}）\n若你收到这条消息，说明该渠道配置正确 ✅"
